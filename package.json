{
  "name": "new-model-smell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets:measure": "node scripts/validate-runtime-assets.mjs --update",
    "assets:validate": "node scripts/validate-runtime-assets.mjs",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:staged": "biome check --no-errors-on-unmatched",
    "check:write": "biome check --write .",
    "typecheck": "tsc -b",
    "test:browser": "playwright test",
    "validate": "pnpm check && pnpm typecheck && pnpm assets:validate && pnpm build && pnpm test:browser",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "@react-three/rapier": "2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "lefthook": "2.1.10",
    "typescript": "7.0.2",
    "vite": "^8.1.1"
  }
}
